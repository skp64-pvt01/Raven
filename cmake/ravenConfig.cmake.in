@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT WIN32)
	set(THREADS_PREFER_PTHREAD_FLAG ON)
	find_dependency(Threads)
endif()
# raven::raven links X11::X11 (the static library needs it at link time)
if(@RAVEN_CONFIG_X11@)
	find_dependency(X11)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ravenTargets.cmake")

check_required_components(raven)
